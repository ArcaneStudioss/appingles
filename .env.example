# Copie para .env (nunca versionar o .env). Valores reais ficam em segredo no servidor.
PORT=8080
DATA_DIR=/dados
NODE_ENV=production
SITE_URL=https://inglou.arcanestudios.io
# Tutor de IA (opcional; sem chave o app usa o modo de prática com correção por regras)
ANTHROPIC_API_KEY=
# Modelo padrão e por tarefa (ver docs/PROPOSTA.md, custos de IA)
IA_MODELO=claude-opus-5-5
IA_MODELO_CONVERSA=
IA_MODELO_AVALIACAO=
IA_MODELO_TUTOR=
IA_MODELO_MATERIAL=
# desligado | simulado (só testes) | stripe
PAGAMENTO_MODO=desligado
# Stripe (use PAGAMENTO_MODO=stripe): chave secreta, segredo do webhook (endpoint: SITE_URL/api/v1/stripe/webhook)
# e os dois preços recorrentes criados no painel da Stripe (8 ao todo: Básico, Completo, Família e Turma, cada um mensal e anual; ver src/assinatura.js)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO_MENSAL=
STRIPE_PRICE_BASICO_ANUAL=
STRIPE_PRICE_COMPLETO_MENSAL=
STRIPE_PRICE_COMPLETO_ANUAL=
STRIPE_PRICE_FAMILIA_MENSAL=
STRIPE_PRICE_FAMILIA_ANUAL=
STRIPE_PRICE_TURMA_MENSAL=
STRIPE_PRICE_TURMA_ANUAL=
# Backup (ver scripts/backup.js)
BACKUP_S3_ENDPOINT=https://SEU_ID_DA_CONTA.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=inglou
BACKUP_S3_REGIAO=auto
BACKUP_S3_CHAVE_ID=
BACKUP_S3_SEGREDO=
BACKUP_S3_PREFIXO=inglou/

# "Falar com a gente" (plano sob consulta, 21+ alunos): link do WhatsApp (https://wa.me/55...) ou mailto:
CONTATO_URL=

# Copie para .env (nunca versionar o .env). Valores reais ficam em segredo no servidor.
PORT=8080
DATA_DIR=/dados
# IDs numéricos de contas já existentes autorizadas à revisão editorial (vazio: ninguém).
INGLOU_ADMIN_IDS=
# Preparação antecipada de áudio: conta administrativa e tamanho máximo do lote.
VOZ_PREPARAR_USUARIO=
VOZ_PREPARAR_LIMITE=20
NODE_ENV=production
SITE_URL=https://inglou.arcanestudios.io
# Tutor de IA (opcional; sem chave o app usa o modo de prática com correção por regras)
ANTHROPIC_API_KEY=
# Vozes oficiais (obrigatório para ouvir; nunca há substituição pela voz do aparelho)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Frases e leitura expressiva: modelo com controle emocional; pode consumir mais créditos que Flash.
ELEVENLABS_MODEL_TEXTO=eleven_v4
ELEVENLABS_VOICE_MIA_PT=MeTEa1BhTRHHItBKl2mJ
ELEVENLABS_VOICE_MIA_EN=WshF5zVOQJVpRBKVUjvc
ELEVENLABS_VOICE_TUIUIU_PT=5sXm87IvJC4SNxe0UIfp
ELEVENLABS_VOICE_TUIUIU_EN=1TtJKrO3NEEEDoWRDALC
VOZ_CACHE_DIAS=30
VOZ_CARACTERES_DIA=60000
VOZ_CARACTERES_TOTAL_DIA=300000
# Modelo padrão e por tarefa (ver docs/PROPOSTA.md, custos de IA)
IA_MODELO=claude-opus-5-5
IA_MODELO_CONVERSA=
IA_MODELO_AVALIACAO=
IA_MODELO_TUTOR=
IA_MODELO_MATERIAL=
# desligado | simulado (só testes) | asaas (a integrar)
PAGAMENTO_MODO=desligado
# Backup (ver scripts/backup.js)
BACKUP_S3_ENDPOINT=https://SEU_ID_DA_CONTA.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=inglou
BACKUP_S3_REGIAO=auto
BACKUP_S3_CHAVE_ID=
BACKUP_S3_SEGREDO=
BACKUP_S3_PREFIXO=inglou/

# Login: mantenha local até concluir a configuração do Supabase e SMTP.
AUTH_PROVIDER=local
# Ative somente depois de habilitar/configurar Google no Supabase e cadastrar as URLs de retorno.
AUTH_GOOGLE_ENABLED=0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chave secret (ou service_role legada): somente no servidor; usada para excluir a identidade.
SUPABASE_SECRET_KEY=
# 64 caracteres hexadecimais aleatórios; mesmo valor nas duas réplicas da VPS.
AUTH_SESSION_KEY=

# Teto global mensal de novas gerações (USD); inclui as duas réplicas.
IA_ORCAMENTO_GLOBAL_USD=10
VOZ_ORCAMENTO_GLOBAL_USD=5
# Stripe: ainda não operacional. Não ative cobrança apenas preenchendo variáveis.
# Veja docs/PLANOS-E-STRIPE.md para os oito preços e a preparação da integração.
